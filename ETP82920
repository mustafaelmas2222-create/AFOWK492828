-- LERP İLE AKICI SÜRÜKLENEBİLİR MENÜ SİSTEMİ
-- ==========================================
local function makeLerpDraggable(win, targets, lerpSpeed, onStep)
	local dragging = false
	local activeInput = nil
	local dragStart = Vector2.zero
	local startPos = win.Position
	local targetPos = win.Position
	local speed = lerpSpeed or 18

	local function startDrag(input)
		if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not activeInput then
			dragging = true
			activeInput = input
			dragStart = input.Position
			startPos = win.Position
			targetPos = win.Position
		end
	end

	for _, target in ipairs(targets) do
		target.InputBegan:Connect(startDrag)
	end

	UserInputService.InputChanged:Connect(function(input)
		if dragging and input == activeInput then
			local delta = input.Position - dragStart
			local rawX = startPos.X.Offset + delta.X
			local rawY = startPos.Y.Offset + delta.Y

			local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(854, 480)
			local halfW, halfH = win.AbsoluteSize.X / 2, win.AbsoluteSize.Y / 2

			local minX = halfW - (viewport.X / 2)
			local maxX = (viewport.X / 2) - halfW
			local minY = halfH - (viewport.Y / 2)
			local maxY = (viewport.Y / 2) - halfH

			targetPos = UDim2.new(
				0.5,
				math.clamp(rawX, minX, maxX),
				0.5,
				math.clamp(rawY, minY, maxY)
			)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input == activeInput then
			dragging = false
			activeInput = nil
		end
	end)

	RunService.RenderStepped:Connect(function(dt)
		if not win or not win.Parent then return end
		local alpha = math.clamp(dt * speed, 0, 1)
		local nextPos = win.Position:Lerp(targetPos, alpha)
		win.Position = nextPos
		if onStep then
			onStep(dragging, nextPos)
		end
	end)
end

