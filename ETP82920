		clone.PrimaryPart = root
		clone:PivotTo(CFrame.new(0, 0, 0))
	end

	clone.Parent = worldModel
	previewModel = clone

	local hum = clone:FindFirstChildOfClass((_v3505832459355148933(51)))
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		local animator = hum:FindFirstChildOfClass((_v3505832459355148933(107))) or Instance.new((_v3505832459355148933(107)))
		animator.Parent = hum
		previewAnimator = animator
	end

	positionCameraOnRig(clone)

	if lastAppliedPackName and PACKS[lastAppliedPackName] then
		previewPlayPackAnim(lastAppliedPackName, currentPreviewState)
	end
end

